# ── Database ───────────────────────────────────────────────────────────────
# Leave empty to use SQLite (zero setup) at data/inventory.db.
# For PostgreSQL, create the database first (see RUNNING.md step 2), then:
#   DATABASE_URL=postgresql://partsid_user:your-password@localhost:5432/partsid
DATABASE_URL=

# ── Vision provider ────────────────────────────────────────────────────────
# auto | gemini-grounded | openai | gemini | anthropic | ollama | offline
#
# "auto" prefers gemini-grounded (Gemini vision + Google Search), then openai,
# gemini, anthropic, ollama, and finally the offline matcher.
#
# Fastest free setup: get a Gemini API key at https://aistudio.google.com/apikey
# (free tier, no card) and set GEMINI_API_KEY below. That single key turns on
# automatic identification *with* Google Search and cited sources.
VISION_PROVIDER=auto
# Optional model override (defaults: gpt-4o-mini / gemini-2.0-flash /
# claude-sonnet-4-20250514 / llava)
VISION_MODEL=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Fully local option (no key, no cloud): serve a vision model with Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llava

# ── Google Search grounding ────────────────────────────────────────────────
# Lets the model search for OEM numbers and cite the pages it used.
# Set false to save quota or when you do not want web lookups.
SEARCH_GROUNDING=true
GROUNDING_MODEL=gemini-2.5-flash

# Public URL of this deployment, used to build one-tap Google Lens links.
# Leave empty to auto-detect from the request (works on any public host).
PUBLIC_BASE_URL=

# ── Shop identity used on every generated card ─────────────────────────────
SHOP_NAME=SHILA AUTO PARTS
SHOP_TAGLINE=OEM & GENUINE SPARE PARTS
WHATSAPP_NUMBER=+254 700 000 000
SHOP_LOCATION=Nairobi, Kenya
CURRENCY=KES

# ── Guard rails ────────────────────────────────────────────────────────────
# Refuse to publish cards for records staff have not verified.
REQUIRE_PART_VERIFICATION=true
# Demo catalogue fills an empty database once. Set false for a real shop so a
# cleared database stays cleared instead of being re-seeded on the next start.
SEED_DEMO_DATA=true
MAX_UPLOAD_MB=12

# ── Storage (defaults live inside the repo, all git-ignored) ───────────────
# APP_DB_PATH=./data/inventory.db
# APP_UPLOAD_DIR=./uploads
# APP_EXPORT_DIR=./exports
