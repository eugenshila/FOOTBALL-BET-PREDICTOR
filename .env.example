# ── Vision provider ────────────────────────────────────────────────────────
# auto | openai | gemini | anthropic | ollama | offline
# "auto" picks the first provider with credentials, then falls back to offline.
VISION_PROVIDER=auto
# Optional model override (defaults: gpt-4o-mini / gemini-2.0-flash /
# claude-sonnet-4-20250514 / llava)
VISION_MODEL=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Fully local option (no key, no cloud): serve a vision model with Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llava

# ── Shop identity used on every generated card ─────────────────────────────
SHOP_NAME=SHILA AUTO PARTS
SHOP_TAGLINE=OEM & GENUINE SPARE PARTS
WHATSAPP_NUMBER=+254 700 000 000
SHOP_LOCATION=Nairobi, Kenya
CURRENCY=KES

# ── Guard rails ────────────────────────────────────────────────────────────
# Refuse to publish cards for records staff have not verified.
REQUIRE_PART_VERIFICATION=true
MAX_UPLOAD_MB=12

# ── Storage (defaults live inside the repo, all git-ignored) ───────────────
# APP_DB_PATH=./data/inventory.db
# APP_UPLOAD_DIR=./uploads
# APP_EXPORT_DIR=./exports
