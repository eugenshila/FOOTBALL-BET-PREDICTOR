# ── Supabase Auth ─────────────────────────────────────────────────────────
# Publishable key is safe in client-facing config. Never use a secret/service_role key.
SUPABASE_URL=https://hcwgmaqeiwmjldroahin.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_MNv9huqc6zTNsAvXe_I-ag_-9-9s8DI

# ── Database ───────────────────────────────────────────────────────────────
# PostgreSQL is the default engine. Create the database and user once
# (see RUNNING.md step 2), then fill in the connection below.
#
# DATABASE_URL overrides everything else when it is set:
#   DATABASE_URL=postgresql://partsid_user:your-password@localhost:5432/partsid
#
# Left empty, the DSN is assembled from these parts. Leave POSTGRES_PASSWORD
# empty to use PGPASSWORD or ~/.pgpass instead of writing a password here.
DATABASE_URL=
DB_ENGINE=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=partsid
POSTGRES_USER=partsid_user
POSTGRES_PASSWORD=
#
# No database server? Opt into SQLite (zero setup) with either line:
#   DB_ENGINE=sqlite
#   DATABASE_URL=sqlite:///./data/inventory.db
# SQLite keeps everything in one file (APP_DB_PATH, default data/inventory.db)
# and is meant for trials and single-user setups, not a busy counter.

# ── Vision provider ────────────────────────────────────────────────────────
# auto | gemini-grounded | openai | gemini | anthropic | ollama | offline
#
# "auto" prefers gemini-grounded (Gemini vision + Google Search), then openai,
# gemini, anthropic, ollama, and finally the offline matcher.
#
# Fastest free setup: get a Gemini API key at https://aistudio.google.com/apikey
# (free tier, no card) and set GEMINI_API_KEY below. That single key turns on
# automatic identification *with* Google Search and cited sources.
VISION_PROVIDER=auto
# Optional model override (defaults: gpt-4o-mini / gemini-2.0-flash /
# claude-sonnet-4-20250514 / llava)
VISION_MODEL=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Fully local option (no key, no cloud): serve a vision model with Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llava

# ── Google Search grounding ────────────────────────────────────────────────
# Lets the model search for OEM numbers and cite the pages it used.
# Set false to save quota or when you do not want web lookups.
SEARCH_GROUNDING=true
GROUNDING_MODEL=gemini-2.5-flash

# Public URL of this deployment, used to build one-tap Google Lens links.
# Leave empty to auto-detect from the request (works on any public host).
PUBLIC_BASE_URL=

# ── Shop identity used on every generated card ─────────────────────────────
SHOP_NAME=SHILA AUTO PARTS
SHOP_TAGLINE=OEM & GENUINE SPARE PARTS
WHATSAPP_NUMBER=+254 700 000 000
SHOP_LOCATION=Nairobi, Kenya
CURRENCY=KES

# ── Guard rails ────────────────────────────────────────────────────────────
# Refuse to publish cards for records staff have not verified.
REQUIRE_PART_VERIFICATION=true
# Demo catalogue fills an empty database once. Set false for a real shop so a
# cleared database stays cleared instead of being re-seeded on the next start.
SEED_DEMO_DATA=true
MAX_UPLOAD_MB=12

# ── Storage (defaults live inside the repo, all git-ignored) ───────────────
# APP_DB_PATH=./data/inventory.db
# APP_UPLOAD_DIR=./uploads
# APP_EXPORT_DIR=./exports

# ── Scheduled cloud backups (S3-compatible object storage) ─────────────────
# Create a PRIVATE bucket with your cloud storage provider first.
# The scheduled backup script requires AWS CLI v2 and PostgreSQL's pg_dump.
# CLOUD_BACKUP_BUCKET=
# CLOUD_BACKUP_PREFIX=verifix/backups
# CLOUD_BACKUP_REGION=us-east-1
# CLOUD_BACKUP_ENDPOINT=       # Set for S3-compatible services; leave blank for AWS S3.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe  # Optional; auto-detected if omitted.
